      <div type="part">
        <head>ODD Customization for Linear A</head>
        <p>This ODD document defines a TEI customization for encoding Linear A inscriptions. It extends the EpiDoc subset of TEI with Linear A-specific elements, attributes, and controlled vocabularies.</p>
      </div>

      <!-- ========================================================= -->
      <!-- MODULE DECLARATIONS                                        -->
      <!-- ========================================================= -->
      <div type="part">
        <head>Module Inclusion</head>
        <schemaSpec ident="linear-a" prefix="LA" xml:lang="en"
          docLang="en" targetLang="en"
          start="TEI">
          <moduleRef key="tei"/>
          <moduleRef key="core"/>
          <moduleRef key="teiheader"/>
          <moduleRef key="textstructure"/>
          <moduleRef key="transcr"/>
          <moduleRef key="linking"/>
          <moduleRef key="analysis"/>
          <moduleRef key="figures"/>
          <moduleRef key="gajji"/>
          <moduleRef key="drama"/>
          <moduleRef key="spoken"/>
          <moduleRef key="header"/>
          <moduleRef key="msdescription"/>
        </schemaSpec>
      </div>

      <!-- ========================================================= -->
      <!-- MACRO / CLASS DECLARATIONS                                 -->
      <!-- ========================================================= -->
      <div type="part">
        <head>Class Declarations</head>

        <classSpec type="model" ident="model.inscriptionPart" module="tei">
          <desc>Groups elements that can appear within a Linear A inscription transcription.</desc>
          <classes>
            <memberOf key="model.linePart"/>
          </classes>
        </classSpec>

        <classSpec type="attributable" ident="att.linearA" module="tei">
          <desc>Attributes specific to Linear A epigraphy.</desc>
          <attList>
            <attDef ident="bennett" usage="req">
              <desc>The Bennett AB/A number for this sign (e.g., "AB 01", "A 338").</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
              <valList type="open">
                <desc>Pattern: (AB|A)\s?\d{2,3}(\.\d+)?</desc>
              </valList>
            </attDef>
            <attDef ident="signType" usage="req">
              <desc>Classification of the sign's function.</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
              <valList type="closed">
                <valItem ident="syllabogram"/>
                <valItem ident="logogram"/>
                <valItem ident="fraction"/>
                <valItem ident="numeral"/>
                <valItem ident="adjunct"/>
                <valItem ident="ligature"/>
                <valItem ident="wordDivider"/>
                <valItem ident="uncertain"/>
              </valList>
            </attDef>
            <attDef ident="siglaVariant" usage="opt">
              <desc>URI pointing to the SigLA variant record for this sign.</desc>
              <datatype>
                <dataRef key="tei.pointer"/>
              </datatype>
            </attDef>
            <attDef ident="confidence" usage="opt">
              <desc>Confidence in sign identification, from 0.0 to 1.0.</desc>
              <datatype>
                <dataRef key="tei.probability"/>
              </datatype>
            </attDef>
          </attList>
        </classSpec>

        <classSpec type="attributable" ident="att.dimensionsLA" module="tei">
          <desc>Dimensions attributes for Linear A objects.</desc>
          <attList>
            <attDef ident="dimUnit" usage="opt">
              <desc>Unit of measurement.</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
              <valList type="closed">
                <valItem ident="mm"/>
                <valItem ident="cm"/>
                <valItem ident="m"/>
                <valItem ident="in"/>
                <valItem ident="ft"/>
              </valList>
            </attDef>
          </attList>
        </classSpec>
      </div>

      <!-- ========================================================= -->
      <!-- ELEMENT SPECIFICATIONS                                     -->
      <!-- ========================================================= -->
      <div type="part">
        <head>Element Specifications</head>

        <!-- Inscription Type -->
        <elementSpec ident="inscriptionType" module="tei" mode="add">
          <desc>Wraps the object type and material of a Linear A inscription.</desc>
          <classes>
            <memberOf key="model.inscriptionPart"/>
          </classes>
          <content>
            <sequence>
              <elementRef key="objectType" minOccurs="1" maxOccurs="1"/>
              <elementRef key="material" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
          </content>
        </elementSpec>

        <elementSpec ident="objectType" module="tei" mode="change">
          <desc>The type of object bearing the Linear A inscription.</desc>
          <classes>
            <memberOf key="model.inscriptionPart"/>
          </classes>
          <content>
            <textNode/>
          </content>
          <attList>
            <attDef ident="ref" usage="opt">
              <desc>URI pointing to a controlled vocabulary term for object type.</desc>
              <datatype>
                <dataRef key="tei.pointer"/>
              </datatype>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Sign Instance (extends g) -->
        <elementSpec ident="g" module="tei" mode="change">
          <desc>A character or glyph representing a Linear A sign.</desc>
          <classes>
            <memberOf key="att.linearA"/>
            <memberOf key="att.global"/>
          </classes>
          <content>
            <sequence>
              <elementRef key="seg" minOccurs="0" maxOccurs="unbounded"/>
              <elementRef key="g" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="ref" usage="opt">
              <desc>URI pointing to the Unicode Aegean block character definition.</desc>
              <datatype>
                <dataRef key="tei.pointer"/>
              </datatype>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Ligature composition -->
        <elementSpec ident="ligature" module="tei" mode="add">
          <desc>An explicit ligature composition, grouping multiple signs that form a single graphic unit.</desc>
          <classes>
            <memberOf key="model.inscriptionPart"/>
          </classes>
          <content>
            <sequence>
              <elementRef key="g" minOccurs="2" maxOccurs="unbounded"/>
            </sequence>
          </content>
        </elementSpec>

        <!-- Word Divider punctuation -->
        <elementSpec ident="pc" module="tei" mode="change">
          <desc>Punctuation or word divider within the inscription.</desc>
          <attList>
            <attDef ident="type" usage="opt">
              <valList type="closed">
                <valItem ident="wordDivider"/>
                <valItem ident="punctuation"/>
                <valItem ident="filler"/>
                <valItem ident="uncertain"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Multi-spectral image band -->
        <elementSpec ident="msiBand" module="figures" mode="add">
          <desc>Reference to a specific multi-spectral imaging band of an inscription image.</desc>
          <classes>
            <memberOf key="att.global"/>
          </classes>
          <content>
            <sequence>
              <elementRef key="graphic" minOccurs="1" maxOccurs="1"/>
              <elementRef key="desc" minOccurs="0" maxOccurs="1"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="band" usage="req">
              <desc>Type of multi-spectral band.</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
              <valList type="closed">
                <valItem ident="infrared"/>
                <valItem ident="ultraviolet"/>
                <valItem ident="rakingLight"/>
                <valItem ident="rti"/>
                <valItem ident="visibleLight"/>
                <valItem ident="xray"/>
                <valItem ident="ct"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Scribal hand note -->
        <elementSpec ident="handNote" module="tei" mode="change">
          <desc>Description of a scribal hand.</desc>
          <attList>
            <attDef ident="handId" usage="req">
              <desc>Unique identifier for this hand.</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
            </attDef>
            <attDef ident="certainty" usage="opt">
              <desc>Confidence in the hand identification.</desc>
              <datatype>
                <dataRef key="tei.probability"/>
              </datatype>
            </attDef>
            <attDef ident="scope" usage="opt">
              <desc>Scope of this hand across the inscription.</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
              <valList type="closed">
                <valItem ident="entire"/>
                <valItem ident="partial"/>
                <valItem ident="side"/>
                <valItem ident="line"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Origin/Findspot with coordinate support -->
        <elementSpec ident="origPlace" module="tei" mode="change">
          <desc>The findspot (provenance) of the inscription.</desc>
          <attList>
            <attDef ident="type" usage="opt">
              <valList type="closed">
                <valItem ident="findspot"/>
                <valItem ident="allegedFindspot"/>
                <valItem ident="uncertainFindspot"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Date with Minoan period support -->
        <elementSpec ident="date" module="tei" mode="change">
          <desc>Date of the inscription, with support for Minoan chronological periods.</desc>
          <attList>
            <attDef ident="period" usage="opt">
              <desc>Minoan period designation.</desc>
              <datatype>
                <dataRef key="tei.enumerated"/>
              </datatype>
              <valList type="open">
                <desc>Values from CV:periods (MM II, MM III, LM IA, LM IB, etc.)</desc>
              </valList>
            </attDef>
            <attDef ident="type" usage="opt">
              <valList type="closed">
                <valItem ident="minoanPeriod"/>
                <valItem ident="bceRange"/>
                <valItem ident="absolute"/>
                <valItem ident="relative"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Metadata for Linear B cross-reference -->
        <elementSpec ident="relation" module="tei" mode="change">
          <desc>Cross-reference to related signs in other scripts.</desc>
          <attList>
            <attDef ident="type" usage="req">
              <valList type="closed">
                <valItem ident="linearB"/>
                <valItem ident="cyproMinoan"/>
                <valItem ident="cretanHieroglyphic"/>
                <valItem ident="eteocretan"/>
                <valItem ident="sameInscription"/>
              </valList>
            </attDef>
            <attDef ident="target" usage="req">
              <desc>URI or identifier of the related sign/text.</desc>
              <datatype>
                <dataRef key="tei.pointer"/>
              </datatype>
            </attDef>
            <attDef ident="notes" usage="opt">
              <desc>Scholarly notes about the relationship.</desc>
              <datatype>
                <dataRef key="tei.text"/>
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
      </div>

