  <text>
    <body>
      <div type="inscription">
        <head>HT 1 — Economic tally</head>
        <ab n="1">
          <!-- Line 1 -->
          <lb n="1"/>

          <!-- Sign 1: AB 02 = ro -->
          <g ref="https://unicode.org/charts/PDF/U10600.pdf#U+10602"
             bennett="AB 02"
             signType="syllabogram"
             siglaVariant="https://sigla.phis.me/variant/AB02_v1"
             confidence="1.0">
            <seg type="translit">ro</seg>
          </g>

          <!-- Sign 2: AB 26 = ru -->
          <g ref="https://unicode.org/charts/PDF/U10600.pdf#U+1061A"
             bennett="AB 26"
             signType="syllabogram"
             confidence="0.95">
            <seg type="translit">ru</seg>
          </g>

          <!-- Word divider -->
          <pc type="wordDivider"/>

          <!-- Sign 3: A 338 = GRAIN logogram -->
          <g ref="https://unicode.org/charts/PDF/U10600.pdf#U+1065C"
             bennett="A 338"
             signType="logogram"
             confidence="1.0">
            <seg type="translit">GRAIN</seg>
          </g>

          <!-- Numeral: 12 -->
          <num value="12">12</num>

          <!-- Line 2 -->
          <lb n="2"/>

          <!-- Sign 4: AB 01 = da -->
          <g bennett="AB 01"
             signType="syllabogram"
             confidence="0.80">
            <seg type="translit">da</seg>
          </g>

          <!-- Sign 5: AB 80 = ma -->
          <g bennett="AB 80"
             signType="syllabogram"
             confidence="0.70">
            <seg type="translit">ma</seg>
          </g>

          <!-- Damage and gap -->
          <damage/>
          <gap extent="2" unit="chars" reason="surface lost"/>

          <!-- Sign 6 (partial): AB ? -->
          <g bennett="AB ??"
             signType="syllabogram"
             confidence="0.15">
            <seg type="translit">[?]</seg>
          </g>
        </ab>
      </div>
    </body>
  </text>
</TEI>
